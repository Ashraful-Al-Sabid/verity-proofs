# Public browser configuration. Legacy anon keys remain supported.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix Gemini or Supabase secret keys with VITE_.
GEMINI_API_KEY=

# Additional / Secondary Gemini API Keys (auto-rotated when daily free tier quota is hit):
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Or comma-separated list of keys:
# GEMINI_API_KEYS=key1,key2,key3

# Fallback AI Providers (activated automatically if all Gemini keys run out of quota or fail):
# GROQ_API_KEY=          # Free tier available at console.groq.com (Llama 3.3 70B)
# OPENAI_API_KEY=        # OpenAI API key (gpt-4o-mini)
# OPENROUTER_API_KEY=    # OpenRouter API key

# Existing Vercel projects may continue using these server variables:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
