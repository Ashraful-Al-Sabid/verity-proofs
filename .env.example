# Public browser configuration. Legacy anon keys remain supported.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix Gemini or Supabase secret keys with VITE_.
GEMINI_API_KEY=

# Existing Vercel projects may continue using these server variables:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
